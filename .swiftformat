# SwiftFormat configuration for DateTimeExtractor
# Aligned with .swiftlint.yml so `make format` and `make lint` do not fight each other.

# SwiftLint's `trailing_comma` rule flags trailing commas in collection literals,
# so make SwiftFormat strip them instead of adding them.
--commas inline

# SwiftLint's `opening_brace` rule wants the opening brace on the same line as the
# declaration; SwiftFormat's wrapMultilineStatementBraces moves it to its own line.
--disable wrapMultilineStatementBraces

# Build artifacts are not source.
--exclude .build,.swiftpm
